{
  "name": "@theagenticengineer/stylelint-sass",
  "version": "0.2.0",
  "description": "Stylelint plugin for Sass indented syntax (.sass) linting",
  "keywords": [
    "stylelint",
    "stylelint-plugin",
    "sass",
    "indented-syntax",
    "linter",
    "css"
  ],
  "type": "module",
  "license": "MIT",
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./recommended": "./dist/recommended.js",
    "./syntax": "./dist/syntax.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theagenticengineer/stylelint-sass.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "sass-parser": ">=0.4 <0.6",
    "stylelint": ">=17.8.0 <19"
  },
  "scripts": {
    "lint": "eslint . && markdownlint-cli2 '**/*.md' '#node_modules' '#.worktrees'",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules' '#.worktrees'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "husky",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.0",
    "eslint": "^10.0.1",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-tsdoc": "^0.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.21.0",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "sass-parser": "^0.5.6",
    "stylelint": "^18.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "eslint-plugin-tsdoc@0.4.0": "patches/eslint-plugin-tsdoc@0.4.0.patch"
    }
  },
  "packageManager": "pnpm@10.18.3"
}
